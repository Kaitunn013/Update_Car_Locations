MQTT_URL=mqtts://your-hivemq-host

# ใส่ car ID คั่นด้วย comma เช่น car-id-1,car-id-2
CAR_IDS=car-id-1,car-id-2

# credential ของรถคันที่ 1 ตามลำดับใน CAR_IDS
CAR_1_MQTT_USERNAME=car-1-hivemq-username
CAR_1_MQTT_PASSWORD=car-1-hivemq-password

# credential ของรถคันที่ 2 ตามลำดับใน CAR_IDS
CAR_2_MQTT_USERNAME=car-2-hivemq-username
CAR_2_MQTT_PASSWORD=car-2-hivemq-password

# topic จะถูกสร้างเป็น MQTT_TOPIC_PREFIX/<car-id>
MQTT_TOPIC_PREFIX=cars

# เส้นทางเริ่มต้น หากไม่ได้กำหนด CAR_ROUTES
ROUTE_FILE=route.geojson

# กำหนดเส้นทางแยกตามรถ (ถ้าต้องการ)
# CAR_ROUTES=car-id-1=route.geojson,car-id-2=route2.geojson

# MQTT_USERNAME และ MQTT_PASSWORD แบบเดิมยังใช้เป็นค่า fallback ได้
